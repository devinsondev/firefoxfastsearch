{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.3.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefoxfastsearch@devinsondev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Fast Search — Quick Settings",
    "default_icon": "icons/icon.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "96": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "search-foreground": {
      "suggested_key": {
        "default": "F1"
      },
      "description": "Search selection (profile 1)"
    },
    "search-background": {
      "description": "Search selection (profile 2)"
    },
    "search-profile-03": {
      "description": "Search selection (profile 3)"
    },
    "search-profile-04": {
      "description": "Search selection (profile 4)"
    },
    "search-profile-05": {
      "description": "Search selection (profile 5)"
    },
    "search-profile-06": {
      "description": "Search selection (profile 6)"
    },
    "search-profile-07": {
      "description": "Search selection (profile 7)"
    },
    "search-profile-08": {
      "description": "Search selection (profile 8)"
    },
    "search-profile-09": {
      "description": "Search selection (profile 9)"
    },
    "search-profile-10": {
      "description": "Search selection (profile 10)"
    },
    "search-profile-11": {
      "description": "Search selection (profile 11)"
    },
    "search-profile-12": {
      "description": "Search selection (profile 12)"
    },
    "search-profile-13": {
      "description": "Search selection (profile 13)"
    },
    "search-profile-14": {
      "description": "Search selection (profile 14)"
    },
    "search-profile-15": {
      "description": "Search selection (profile 15)"
    },
    "search-profile-16": {
      "description": "Search selection (profile 16)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core/icon-placement.js",
        "selection-icon.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
